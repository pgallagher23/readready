# Caddy reverse proxy configuration
#
# For local/HTTP-only:
:80 {
    request_body {
        max_size 100MB
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
    }
    reverse_proxy app:7860
}

#enable the below to passthru Flower on port 8080. Will also need to update docker-compose.yaml
# Flower — Celery monitoring dashboard on port 8080
#:8080 {
#    reverse_proxy flower:5555
#}

