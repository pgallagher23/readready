# VLM provider keys (only the one matching llm.provider in config.yaml is needed; none for local Ollama)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Redis (docker compose)
# required: use a long random value
REDIS_PASSWORD=
REDIS_URL=

# Main web UI login (app.py). Setting READREADY_SECRET turns on a login for the main UI;
# leave it empty for no login. READREADY_USER defaults to readready.
READREADY_USER=
READREADY_SECRET=

# Optional overrides
READREADY_CONFIG=
READREADY_FONT_DIR=
