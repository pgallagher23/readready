<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs filter for the PDF Accessibility iText tagger.

  Documented in JAVA_AUDIT_REPORT.md §4 (iText listener-pattern noise).
  Triaged 2026-05-29 — every excluded category was spot-checked at the
  iText API boundary and verified to be a false positive against the
  iText 9.5 contract or the single-threaded subprocess execution model.

  To re-include any of these categories during a deep review, comment
  out the relevant <Match> block.
-->
<FindBugsFilter>

  <!-- §4.1 — iText API boundary methods declare `throws Exception`,
       so catching Exception is the contractual pattern, not over-broad. -->
  <Match>
    <Class name="~pdfaccessibility\..*"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!-- §4.2 — iText listener-pattern: casts gated by EventType. -->
  <Match>
    <Class name="pdfaccessibility.ContentStreamAnalyzer$PageAnalysisListener"/>
    <Method name="eventOccurred"/>
    <Bug pattern="BC_UNCONFIRMED_CAST"/>
  </Match>

  <!-- §4.3 — top-level entry points and AFM parsers throw Exception
       because their iText call stacks do. Narrowing would require
       multi-type catch chains for little benefit. -->
  <Match>
    <Class name="~pdfaccessibility\..*"/>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>

  <!-- §3 — sq* counters in PdfAccessibilityTagger are written from a
       single-threaded main() in a one-shot subprocess. The static state
       is not shared across threads. -->
  <Match>
    <Class name="pdfaccessibility.PdfAccessibilityTagger"/>
    <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE,
                  AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE"/>
  </Match>

</FindBugsFilter>
